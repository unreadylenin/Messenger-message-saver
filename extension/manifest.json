{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Msg Saver",
  "version": "1.2.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "lib/i18n.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "dashboard/options.html",
  "commands": {
    "toggle-unseen": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_cmdToggleUnseen__"
    }
  }
}
